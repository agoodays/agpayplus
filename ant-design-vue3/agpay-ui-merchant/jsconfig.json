{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/api/*": ["src/api/*", "../shared/api/*"],
      "@/assets/*": ["src/assets/*", "../shared/assets/*"],
      "@/components/*": ["src/components/*", "../shared/components/*"],
      "@/composables/*": ["src/composables/*", "../shared/composables/*"],
      "@/config/*": ["src/config/*", "../shared/config/*"],
      "@/constants/*": ["src/constants/*", "../shared/constants/*"],
      "@/i18n/*": ["src/i18n/*", "../shared/i18n/*"],
      "@/layouts/*": ["src/layouts/*", "../shared/layouts/*"],
      "@/lib/*": ["src/lib/*", "../shared/lib/*"],
      "@/router/*": ["src/router/*", "../shared/router/*"],
      "@/store/*": ["src/store/*", "../shared/store/*"],
      "@/styles/*": ["src/styles/*", "../shared/styles/*"],
      "@/theme/*": ["src/theme/*", "../shared/theme/*"],
      "@/utils/*": ["src/utils/*", "../shared/utils/*"],
      "@/views/*": ["src/views/*", "../shared/views/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.vue", "../shared/**/*.js", "../shared/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
// AGooday.AgPay.Agent.Api 差异配置（生产）
//
// 本文件只保留【该服务自身的差异项】；公共项已收敛到同目录上层的 appsettings.Shared.json，
// 由 AgPayApiHostExtensions.AddAgPayApiHost 以最低优先级加载（环境变量仍可覆盖）。
{
    "Cors": {
        "AllowedOrigins": [
            "https://localhost:8816",
            "http://localhost:8816"
        ] // 允许的前端地址
    },

    "JWT": {
        "Issuer": "https://localhost:9816",
        "Audience": "https://localhost:9816"
    },

    "IdWorkerConfig": {
        "IsUseSnowflakeId": true,
        "DataCenterId": 1,
        "MachineId": 1
    },

    "Redis": {
        "Default": {
            "Connection": "agpay-redis:6379,abortConnect=false,defaultDatabase=2",
            "InstanceName": "",
            "DefaultDB": 2 // 1库：运营平台  #2库：代理商系统 #3库：商户系统 #4库：支付网关
        }
    },

    "Notice": {
        "IntervalSeconds": 10, //发送间隔（仅限同一标题），避免短时间内发送大量相同的消息

        //【邮件配置】
        "Mail": {
            "Host": "smtp.qq.com", //SMTP地址
            "Port": 465, //SMTP端口
            "FromName": "xxx@foxmail.com", //发件人（可自定义）
            "FromAddress": "xxx@foxmail.com", //发件地址（需与密码匹配）
            "Password": "******", //发件密码
            "ToAddress": [ "123@qq.com" ] //接收邮件的地址
        }
    },

    "Logging": {
        "LogLevel": {
            "Default": "Trace",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    // ✅ 自定义字段（用于你的扩展方法）
    "AgSerilog": {
        "SystemName": "Agent",
        "Version": "1.0.0",
        "BaseLogPath": "/app/agpayplus/logs/agent",
        "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{SystemName}:{Version}][{CRequestId}]-[{RequestId}]:{UserId} [{ThreadId}] {Level:u3} {SourceContext} - {Message:lj}{NewLine}{Exception}",
        "SeqUrl": "http://seq.example.com",
        "SeqApiKey": "",
        "EnableSeq": true
    },

    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://host.docker.internal:5816"
            },
            "Https": {
                "Url": "https://host.docker.internal:9816",
                "Certificate": {
                    "Path": "/https/agpayplusapi.pfx", // 替换为你的证书路径
                    "Password": "123456" // 替换为你的证书密码
                }
            }
        }
    }
}

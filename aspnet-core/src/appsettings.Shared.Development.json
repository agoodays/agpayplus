// ============================================================================
// AgPay 共享配置 —— 由 4 个 API 的 appsettings.json 收敛而来，请勿在各 API 文件里重复这些项。
//
// 加载优先级（低 -> 高）。由 AgPayApiHostExtensions.AddAgPayApiHost 插入到配置源【最前面】：
//   appsettings.Shared.json
//   appsettings.Shared.{Environment}.json
//   appsettings.json               （各 API 自身的差异项）
//   appsettings.{Environment}.json
//   环境变量 / 命令行             <- docker-compose 注入的 .env 仍然优先级最高
//
// 本文件 = 【四端一致、但仅开发环境】的公共项（生产对应值见 appsettings.Shared.json）：
//   ConnectionStrings:Default / MQ:RabbitMQ:HostName / AppSettings:ForceHttpsRedirection
// 之所以单独成文件而不并入 Shared.json，见 appsettings.Shared.json 表头说明。
// ============================================================================
{
    "ConnectionStrings": {
        "Default": "server=localhost;port=3306;uid=root;pwd=Mysql@Local2024;database=agpayplusdb_dev"
    },

    "AppSettings": {
        "ForceHttpsRedirection": false
    },

    "MQ": {
        "Vender": "RabbitMQ",
        "RabbitMQ": {
            "HostName": "127.0.0.1",
            "UserName": "guest",
            "Password": "guest",
            "Port": "5672"
        }
    }
}

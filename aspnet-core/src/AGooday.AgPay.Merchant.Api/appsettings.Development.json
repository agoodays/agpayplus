// AGooday.AgPay.Merchant.Api 差异配置（开发）
//
// 本文件只保留【该服务自身的差异项】；公共项已收敛到同目录上层的 appsettings.Shared.json，
// 由 AgPayApiHostExtensions.AddAgPayApiHost 以最低优先级加载（环境变量仍可覆盖）。
{
    "Redis": {
        "Default": {
            "Connection": "127.0.0.1:6379,abortConnect=false,defaultDatabase=3",
            "InstanceName": "",
            "DefaultDB": 3 // 1库：运营平台  #2库：代理商系统 #3库：商户系统 #4库：支付网关
        }
    },

    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5818"
            },
            "Https": {
                "Url": "https://localhost:9818",
                "Certificate": {
                    "Path": "", // 替换为你的证书路径
                    "Password": "" // 替换为你的证书密码
                }
            }
        }
    }
}

// ============================================================================
// AgPay 共享配置 —— 由 4 个 API 的 appsettings.json 收敛而来，请勿在各 API 文件里重复这些项。
//
// 加载优先级（低 -> 高）。由 AgPayApiHostExtensions.AddAgPayApiHost 插入到配置源【最前面】：
//   appsettings.Shared.json
//   appsettings.Shared.{Environment}.json
//   appsettings.json               （各 API 自身的差异项）
//   appsettings.{Environment}.json
//   环境变量 / 命令行             <- docker-compose 注入的 .env 仍然优先级最高
//
// 约定：同一个「叶子键」不要同时出现在 Shared 与各 API 文件中；
//       两个 Shared 文件之间允许重叠（Shared.{Env} 覆盖 Shared，顺序由代码固定）。
//
// 为什么是「两个」共享文件而不是一个（请勿顺手合并）：
//   本文件只放【跨环境也相同】的公共项；凡是「四端一致、但开发与生产取值不同」的键
//   （ConnectionStrings:Default、MQ:RabbitMQ:HostName、AppSettings:ForceHttpsRedirection）
//   都放在 appsettings.Shared.Development.json 里。
//   若强行合成一个文件，这些键只能退回各 API 的 appsettings.Development.json，
//   于是 4 个项目各存一份（包括开发库的连接串），反而违背「共享」的初衷。
//   物理文件仍只有一份：它位于 src/ 下，由 4 个 .csproj 以 <Content ... Link="..."> 链接引用。
// ============================================================================
{
    "ConnectionStrings": {
        "Default": "server=host.docker.internal;port=3306;uid=root;pwd=Mysql@Local2024;database=agpayplusdb_dev"
    },

    "AppSettings": {
        "ForceHttpsRedirection": true
    },

    "AesKey": "4ChT08phkz59hquD795X7w==",

    "SysRSA2": {
        "PublicKey": "",
        "PrivateKey": ""
    },

    "MQ": {
        "Vender": "RabbitMQ",
        "RabbitMQ": {
            "HostName": "agpay-rabbitmq",
            "UserName": "guest",
            "Password": "guest",
            "Port": "5672"
        }
    },

    "OSS": {
        "ServiceType": "local",
        "FileRootPath": "/app/agpayplus/upload", //存储根路径 ( 无需以‘/’结尾 )
        "FilePublicPath": "/app/agpayplus/upload/public", //公共读取块  ( 一般配合root-path参数进行设置，需以‘/’ 开头, 无需以‘/’结尾 )
        "FilePrivatePath": "/app/agpayplus/upload/private", //私有化本地访问，不允许url方式公共读取 ( 一般配合root-path参数进行设置，需以‘/’ 开头, 无需以‘/’结尾  )
        "AliyunOss": {
            "Endpoint": "oss-cn-beijing.aliyuncs.com",
            "PublicBucketName": "bucket1",
            "PrivateBucketName": "bucket2",
            "AccessKeyId": "T5w****gI0****qch",
            "AccessKeySecret": "u17oH**********aoApV**********"
        }
    },

    // ⚠️ 以下为 Serilog 原生配置（必须保留）
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Thread" ],
        "MinimumLevel": "Debug",
        "Enrich": [ "FromLogContext", "WithThreadId" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:HH:mm:ss zzz} [{SystemName}:{Version}][{CRequestId}]-[{RequestId}]:{UserId} [{ThreadId}] {Level:u3} {SourceContext} - {Message:lj}{NewLine}{Exception}"
                }
            }
            // ⚠️ 文件输出不再在这里写！由 C# 动态添加
        ]
    },

    "AllowedHosts": "*",

    // JWT 签名密钥：三端（Manager/Agent/Merchant）原值相同，集中于此便于轮换
    "JWT": {
        "Secret": "JWTAuthenticationHIGHsecuredPasswordVVVp1OH7Xzyr"
    }
}

// AGooday.AgPay.Payment.Api 差异配置（开发）
//
// 本文件只保留【该服务自身的差异项】；公共项已收敛到同目录上层的 appsettings.Shared.json，
// 由 AgPayApiHostExtensions.AddAgPayApiHost 以最低优先级加载（环境变量仍可覆盖）。
{
    "Redis": {
        "Default": {
            "Connection": "127.0.0.1:6379,abortConnect=false,defaultDatabase=4",
            "InstanceName": "",
            "DefaultDB": 4 // 1库：运营平台  #2库：代理商系统 #3库：商户系统 #4库：支付网关
        }
    },

    "Quartz": {
        // ========== Quartz 集群配置（支持分布式部署）==========
        "quartz.scheduler.instanceName": "AgPayPaymentScheduler",
        "quartz.scheduler.instanceId": "AUTO", // 自动生成实例 ID

        // ========== 使用数据库存储（支持集群模式）==========
        // 注意：启用前需要先创建 Quartz 数据库表
        // 下载脚本: https://github.com/quartznet/quartznet/blob/main/database/tables/tables_mysql.sql
        // "quartz.jobStore.type": "Quartz.Impl.AdoJobStore.JobStoreTX, Quartz",
        // "quartz.jobStore.driverDelegateType": "Quartz.Impl.AdoJobStore.MySQLDelegate, Quartz",
        // "quartz.jobStore.tablePrefix": "QRTZ_",
        // "quartz.jobStore.dataSource": "default",
        // "quartz.jobStore.clustered": "true", // ✅ 启用集群模式
        // "quartz.jobStore.clusterCheckinInterval": "10000", // 集群检查间隔 10秒
        // "quartz.jobStore.misfireThreshold": "60000", // Misfire 阈值 60秒

        // ========== 数据源配置 ==========
        // "quartz.dataSource.default.provider": "MySql",
        // "quartz.dataSource.default.connectionString": "server=localhost;port=3306;uid=root;pwd=Mysql@Local2024;database=agpayplusdb_dev;Allow User Variables=True",

        // ========== 线程池配置 ==========
        "quartz.threadPool.type": "Quartz.Simpl.DefaultThreadPool, Quartz",
        "quartz.threadPool.threadCount": "10",
        "quartz.threadPool.threadPriority": "Normal",

        // ========== 任务配置 ==========
        "Jobs": [
            {
                "JobType": "PayOrderDivisionRecordReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "分账补单处理"
            },
            {
                "JobType": "PayOrderExpiredJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "订单过期处理"
            },
            {
                "JobType": "PayOrderReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "订单补单处理"
            },
            {
                "JobType": "RefundOrderExpiredJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "退款订单过期处理"
            },
            {
                "JobType": "RefundOrderReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "退款订单补单处理"
            },
            {
                "JobType": "TransferOrderReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "转账订单补单处理"
            }
        ]
    },

    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5819"
            },
            "Https": {
                "Url": "https://localhost:9819",
                "Certificate": {
                    "Path": "", // 替换为你的证书路径
                    "Password": "" // 替换为你的证书密码
                }
            }
        }
    }
}

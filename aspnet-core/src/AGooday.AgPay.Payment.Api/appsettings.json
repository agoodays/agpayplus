// AGooday.AgPay.Payment.Api 差异配置（生产）
//
// 本文件只保留【该服务自身的差异项】；公共项已收敛到同目录上层的 appsettings.Shared.json，
// 由 AgPayApiHostExtensions.AddAgPayApiHost 以最低优先级加载（环境变量仍可覆盖）。
{
    "Cors": {
        "AllowedOrigins": [
            "https://localhost:8819",
            "http://localhost:8819"
        ] // 允许的前端地址
    },

    "IdWorkerConfig": {
        "IsUseSnowflakeId": true,
        "DataCenterId": 1,
        "MachineId": 1
    },

    "Redis": {
        "Default": {
            "Connection": "agpay-redis:6379,abortConnect=false,defaultDatabase=4",
            "InstanceName": "",
            "DefaultDB": 4 // 1库：运营平台  #2库：代理商系统 #3库：商户系统 #4库：支付网关
        }
    },

    "Quartz": {
        // ========== Quartz 集群配置（支持分布式部署）==========
        "quartz.scheduler.instanceName": "AgPayPaymentScheduler",
        "quartz.scheduler.instanceId": "AUTO", // 自动生成实例 ID
        
        // ========== 使用数据库存储（支持集群模式）==========
        // 注意：启用前需要先创建 Quartz 数据库表
        // 下载脚本: https://github.com/quartznet/quartznet/blob/main/database/tables/tables_mysql.sql
        // "quartz.jobStore.type": "Quartz.Impl.AdoJobStore.JobStoreTX, Quartz",
        // "quartz.jobStore.driverDelegateType": "Quartz.Impl.AdoJobStore.MySQLDelegate, Quartz",
        // "quartz.jobStore.tablePrefix": "QRTZ_",
        // "quartz.jobStore.dataSource": "default",
        // "quartz.jobStore.clustered": "true", // ✅ 启用集群模式
        // "quartz.jobStore.clusterCheckinInterval": "10000", // 集群检查间隔 10秒
        // "quartz.jobStore.misfireThreshold": "60000", // Misfire 阈值 60秒
        
        // ========== 数据源配置 ==========
        // "quartz.dataSource.default.provider": "MySql",
        // "quartz.dataSource.default.connectionString": "server=host.docker.internal;port=3306;uid=root;pwd=Mysql@Local2024;database=agpayplusdb_dev;Allow User Variables=True",
        
        // ========== 线程池配置 ==========
        "quartz.threadPool.type": "Quartz.Simpl.DefaultThreadPool, Quartz",
        "quartz.threadPool.threadCount": "10",
        "quartz.threadPool.threadPriority": "Normal",
        
        // ========== 任务配置 ==========
        "Jobs": [
            {
                "JobType": "PayOrderDivisionRecordReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "分账补单处理"
            },
            {
                "JobType": "PayOrderExpiredJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "订单过期处理"
            },
            {
                "JobType": "PayOrderReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "订单补单处理"
            },
            {
                "JobType": "RefundOrderExpiredJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "退款订单过期处理"
            },
            {
                "JobType": "RefundOrderReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "退款订单补单处理"
            },
            {
                "JobType": "TransferOrderReissueJob",
                "CronExpression": "0 0/1 * * * ?",
                "Description": "转账订单补单处理"
            },
            {
                "JobType": "ApplymentReissueJob",
                "CronExpression": "0 0/10 * * * ?",
                "Description": "商户进件状态同步（轮询渠道审核结果）"
            }
        ]
    },

    "Notice": {
        "IntervalSeconds": 10, //发送间隔（仅限同一标题），避免短时间内发送大量相同的消息

        //【邮件配置】
        "Mail": {
            "Host": "smtp.qq.com", //SMTP地址
            "Port": 465, //SMTP端口
            "FromName": "xxx@foxmail.com", //发件人（可自定义）
            "FromAddress": "xxx@foxmail.com", //发件地址（需与密码匹配）
            "Password": "******", //发件密码
            "ToAddress": [ "123@qq.com" ] //接收邮件的地址
        }
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    // ✅ 自定义字段（用于你的扩展方法）
    "AgSerilog": {
        "SystemName": "Payment",
        "Version": "1.0.0",
        "BaseLogPath": "/app/agpayplus/logs/payment",
        "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{SystemName}:{Version}][{CRequestId}]-[{RequestId}]:{UserId} [{ThreadId}] {Level:u3} {SourceContext} - {Message:lj}{NewLine}{Exception}",
        "SeqUrl": "http://seq.example.com",
        "SeqApiKey": "",
        "EnableSeq": true
    },

    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://host.docker.internal:5819"
            },
            "Https": {
                "Url": "https://host.docker.internal:9819",
                "Certificate": {
                    "Path": "/https/agpayplusapi.pfx", // 替换为你的证书路径
                    "Password": "123456" // 替换为你的证书密码
                }
            }
        }
    }
}
